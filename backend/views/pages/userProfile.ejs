<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include("../partials/navbar") %>
    <main class="page-create">
      <section class="public-profile-card">
        <div class="public-profile-top">
          <% if (profileUser.avatarUrl) { %>
            <img src="<%= profileUser.avatarUrl %>" alt="<%= profileUser.name %>" class="public-profile-avatar" />
          <% } else { %>
            <div class="public-profile-fallback"><%= (profileUser.name || '?').split(' ').slice(0, 2).map(function(w) { return w[0] || ''; }).join('').toUpperCase() || '?' %></div>
          <% } %>

          <div class="public-profile-copy">
            <span class="eyebrow">Writer</span>
            <h1><%= profileUser.name %></h1>
            <p class="public-profile-email"><%= profileUser.email %></p>
          </div>
        </div>

        <div class="divider"></div>

        <div class="public-profile-body">
          <p class="field-label">Bio</p>
          <p class="public-profile-bio"><%= profileUser.bio || "This writer has not added a bio yet." %></p>
        </div>
      </section>

      <section class="card" style="max-width:760px;width:100%;margin-top:1rem;">
        <h2>Published posts</h2>
        <% if (!posts.length) { %>
          <p class="muted-copy">No posts yet.</p>
        <% } else { %>
          <div class="post-grid" style="margin-top: 16px;">
            <% posts.forEach(function(post) { %>
              <article class="post-card">
                <div class="card-top">
                  <span class="card-eyebrow">Article</span>
                  <span class="card-date"><%= new Date(post.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                </div>
                <h2 class="card-title"><%= post.title %></h2>
                <p class="card-excerpt"><%= post.excerpt || post.content.slice(0, 160) %></p>
                <div class="card-footer">
                  <div class="card-author">
                    <% if (post.author && post.author.avatarUrl) { %>
                      <img src="<%= post.author.avatarUrl %>" alt="<%= post.author.name %>" class="avatar avatar-img" />
                    <% } else { %>
                      <div class="avatar"><%= (post.author && post.author.name ? post.author.name : '?').split(' ').slice(0, 2).map(function(w) { return w[0] || ''; }).join('').toUpperCase() || '?' %></div>
                    <% } %>
                    <span class="card-author-name"><%= post.author ? post.author.name : 'Unknown' %></span>
                  </div>
                  <div class="card-likes">
                    <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M8 13.5S1.5 9.5 1.5 5.5a3 3 0 015.6-1.5h1.8A3 3 0 0114.5 5.5C14.5 9.5 8 13.5 8 13.5z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                    </svg>
                    <span><%= post.likes ? post.likes.length : 0 %></span>
                  </div>
                </div>
                <a href="/posts/<%= post._id %>" class="card-read-link">
                  Read article
                  <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>
    </main>
    <%- include("../partials/footer") %>
  </body>
</html>
