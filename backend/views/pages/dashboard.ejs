<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="dashboard-flat">
    <%- include("../partials/navbar") %>
    <main class="page dashboard-page">
      <div class="dash-header">
        <div class="dash-title-block">
          <span class="eyebrow">Editorial space</span>
          <h1 class="dash-h1">DevConnect</h1>
          <p class="dash-tagline">A space to share what you are creating and learning.</p>
        </div>
        <div class="dash-counters">
          <div class="dash-counter">
            <strong><%= posts.length %></strong>
            <span>Posts</span>
          </div>
          <div class="dash-counter-sep"></div>
          <div class="dash-counter">
            <strong><%= totalUsers %></strong>
            <span>Writers</span>
          </div>
        </div>
      </div>

      <% if (users && users.length) { %>
        <div class="writers-bar">
          <span class="writers-bar-label">Writers</span>
          <div class="writers-chips-track">
            <% users.forEach(function(user) { %>
              <a href="/users/<%= user._id %>" class="writer-chip">
                <% if (user.avatarUrl) { %>
                  <img src="<%= user.avatarUrl %>" alt="<%= user.name %>" class="writer-chip-avatar" />
                <% } else { %>
                  <div class="writer-chip-avatar writer-chip-fallback"><%= (user.name || '?').split(' ').slice(0, 2).map(function(w) { return w[0] || ''; }).join('').toUpperCase() || '?' %></div>
                <% } %>
                <span class="writer-chip-name"><%= user.name %></span>
              </a>
            <% }) %>
          </div>
        </div>
      <% } %>

      <% if (success) { %>
        <div class="success-box" style="margin-bottom: 14px;"><%= success %></div>
      <% } %>
      <% if (error) { %>
        <div class="error-box" style="margin-bottom: 14px;"><%= error %></div>
      <% } %>

      <div class="dash-filter-row">
        <form action="/" method="get" class="search-wrap dash-search-wrap">
          <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.4" />
            <path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
          </svg>
          <input class="search-input" type="text" name="search" placeholder="Search posts..." value="<%= search %>" />
        </form>
        <span class="section-label"><%= posts.length %> <%= posts.length === 1 ? 'post' : 'posts' %></span>
      </div>

      <section class="post-grid">
        <% if (!posts.length) { %>
          <div class="empty-state">
            <h3>No posts yet</h3>
            <p>Be the first write something from the Write screen.</p>
          </div>
        <% } %>
        <% posts.forEach(function(post) { %>
          <article class="post-card">
            <div class="card-top">
              <span class="card-eyebrow">Article</span>
              <span class="card-date"><%= new Date(post.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
            </div>

            <h2 class="card-title"><%= post.title %></h2>
            <p class="card-excerpt"><%= post.excerpt || post.content.slice(0, 160) %></p>

            <div class="card-footer">
              <div class="card-author">
                <% if (post.author && post.author.avatarUrl) { %>
                  <img src="<%= post.author.avatarUrl %>" alt="<%= post.author.name %>" class="avatar avatar-img" />
                <% } else { %>
                  <div class="avatar"><%= (post.author && post.author.name ? post.author.name : '?').split(' ').slice(0, 2).map(function(w) { return w[0] || ''; }).join('').toUpperCase() || '?' %></div>
                <% } %>
                <span class="card-author-name"><%= post.author ? post.author.name : 'Unknown' %></span>
              </div>
              <div class="card-likes">
                <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M8 13.5S1.5 9.5 1.5 5.5a3 3 0 015.6-1.5h1.8A3 3 0 0114.5 5.5C14.5 9.5 8 13.5 8 13.5z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                </svg>
                <span><%= post.likes ? post.likes.length : 0 %></span>
              </div>
            </div>

            <a href="/posts/<%= post._id %>" class="card-read-link">
              Read article
              <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </article>
        <% }) %>
      </section>
    </main>
    <%- include("../partials/footer") %>
  </body>
</html>
