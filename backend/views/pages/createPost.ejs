<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include("../partials/navbar") %>
    <main class="container auth-page">
      <section class="card">
        <h1>Create post</h1>
        <p class="muted-copy">Publish directly from the EJS app. Title and content are required.</p>
        <% if (error) { %>
          <div class="notice error"><%= error %></div>
        <% } %>
        <form action="/create-post" method="post" class="stack">
          <input type="text" name="title" placeholder="Title" value="<%= formValues.title %>" required />
          <input type="text" name="excerpt" placeholder="Short excerpt" value="<%= formValues.excerpt %>" />
          <input type="text" name="tags" placeholder="Tags (comma separated)" value="<%= formValues.tags %>" />
          <textarea name="content" placeholder="Write your post" required><%= formValues.content %></textarea>
          <button type="submit">Publish post</button>
        </form>
      </section>
    </main>
    <%- include("../partials/footer") %>
  </body>
</html>
