<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include("../partials/navbar") %>
    <main class="container auth-page">
      <section class="card">
        <h1>Create account</h1>
        <p class="muted-copy">Start publishing from the server-rendered version of DevConnect.</p>
        <% if (error) { %>
          <div class="notice error"><%= error %></div>
        <% } %>
        <form action="/register" method="post" class="stack">
          <input type="text" name="name" placeholder="Full name" value="<%= formValues.name %>" required />
          <input type="email" name="email" placeholder="Email" value="<%= formValues.email %>" required />
          <input type="password" name="password" placeholder="Password" required />
          <input type="url" name="avatarUrl" placeholder="Avatar URL (optional)" value="<%= formValues.avatarUrl %>" />
          <textarea name="bio" placeholder="Bio"><%= formValues.bio %></textarea>
          <button type="submit">Register</button>
        </form>
      </section>
    </main>
    <%- include("../partials/footer") %>
  </body>
</html>
