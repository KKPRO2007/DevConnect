<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include("../partials/navbar") %>
    <main class="container stack-xl">
      <section class="hero compact-hero">
        <p class="eyebrow">Your space</p>
        <h1><%= profileUser.name %></h1>
        <p><%= profileUser.bio || "Add a short bio so people know what you care about." %></p>
      </section>

      <% if (success) { %>
        <div class="notice success"><%= success %></div>
      <% } %>
      <% if (error) { %>
        <div class="notice error"><%= error %></div>
      <% } %>

      <section class="two-col">
        <article class="card">
          <h2>Edit profile</h2>
          <form action="/profile" method="post" class="stack">
            <input type="text" name="name" placeholder="Full name" value="<%= formValues.name %>" required />
            <input type="url" name="avatarUrl" placeholder="Avatar URL" value="<%= formValues.avatarUrl %>" />
            <textarea name="bio" placeholder="Tell readers about yourself"><%= formValues.bio %></textarea>
            <input type="password" name="password" placeholder="New password (optional)" minlength="6" />
            <button type="submit">Save changes</button>
          </form>
        </article>

        <article class="card">
          <h2>Your posts</h2>
          <% if (!posts.length) { %>
            <p class="muted-copy">You have not published anything yet.</p>
          <% } else { %>
            <div class="stack">
              <% posts.forEach(function(post) { %>
                <a class="list-link" href="/posts/<%= post._id %>">
                  <strong><%= post.title %></strong>
                  <span><%= post.excerpt || post.content.slice(0, 120) %></span>
                </a>
              <% }) %>
            </div>
          <% } %>
        </article>
      </section>
    </main>
    <%- include("../partials/footer") %>
  </body>
</html>
